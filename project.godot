CameraRide="*res://scripts/core/camera_ride.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
VisualManager="*res://scripts/visuals/visual_manager.gd"
SpriteGenerator="*res://scripts/visuals/sprite_generator.gd"
VisualEffects="*res://scripts/visuals/visual_effects.gd"
HUD="*res://scenes/ui/hud.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/mode=0
window/title="Stardew-Like"

