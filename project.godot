[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/mode=0
window/title="Stardew-Like"

[input]

actions=[{
"deadzone": 0.5,
"events": [{
"physical_keycode": "W",
"type": "Key"
}, {
"physical_keycode": "Up",
"type": "Key"
}],
"name": "move_up"
}, {
"deadzone": 0.5,
"events": [{
"physical_keycode": "S",
"type": "Key"
}, {
"physical_keycode": "Down",
"type": "Key"
}],
"name": "move_down"
}, {
"deadzone": 0.5,
"events": [{
"physical_keycode": "A",
